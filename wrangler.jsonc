{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "makuai",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "makuai",
			// デプロイ前に `wrangler d1 create makuai` で発行された ID に差し替える。
			// ローカル開発(miniflare)はこのままで動く。
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		// 本番デプロイ時に本番 URL へ差し替える(ローカルは .dev.vars が優先される)
		"BETTER_AUTH_URL": "http://localhost:5173"
	},
	// develop 環境: develop ブランチの動作確認用(URL を知っていればアクセス可でOK)
	// デプロイ: npm run deploy:dev / マイグレーション: npm run db:migrate:dev
	"env": {
		"develop": {
			"name": "makuai-develop",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "makuai-develop",
					"database_id": "225b968c-0d3d-44b6-b1a4-7cc406cfe74b",
					"migrations_dir": "migrations"
				}
			],
			"vars": {
				// このオリジンと不一致だと /api/auth/* が 404 になる
				"BETTER_AUTH_URL": "https://makuai-develop.shino3.workers.dev"
			}
		}
	}
}